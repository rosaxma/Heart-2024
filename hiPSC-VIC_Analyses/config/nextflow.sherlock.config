// Nextflow config for the SCEPTRE pipeline (rule run_sceptre_pipeline), passed
// with `nextflow -c`. Copied from the published trans_v2 launch directory
// (6.sceptre/nf_v2noleiden/nextflow.config). Its workDir line is dropped: the
// rule sets the work directory with -w from sceptre.pipeline.work_dir_base.
//
// Sherlock-specific: the Slurm queue, the module loads and the R library and
// font paths in beforeScript. Edit these for another cluster.

process.executor = 'slurm'
executor.queueSize = 100
executor.submitRateLimit = '25 sec'
process.queue = 'engreitz'
process.clusterOptions = { task.memory ? "--mem=${task.memory.toGiga()}G" : "" }
process.beforeScript = 'module load gcc/12.4.0 R/4.3.2; export R_LIBS_USER=/oak/stanford/groups/engreitz/Users/yannick/R_pkgs; export FONTCONFIG_PATH=/share/software/user/open/fontconfig/2.12.4/etc/fonts; export FONT_PATH=/share/software/user/open/x11/7.7/share/fonts/X11; export R_DEFAULT_DEVICE=cairo'


process {
    withName: assign_grnas {
        memory = '128 GB'
        time = '24h'
    }
    withName: 'run_analysis_subworkflow.*:run_association_analysis' {
        memory = '128 GB'
        time = '24h'
    }
    withName: 'run_analysis_subworkflow_discovery_analysis:run_association_analysis' {
        memory = '64 GB'
        time = '24h'
    }
    withName: 'run_analysis_subworkflow.*:combine_association_analysis' {
        memory = '64 GB'
        time = '24h'
    }
    withName: combine_assign_grnas {
        memory = '128 GB'
        time = '24h'
    }
    withName: run_qc {
        memory = '64 GB'
        time = '24h'
    }
    withName: prepare_association_analysis {
        memory = '64 GB'
        time = '24h'
    }
}
