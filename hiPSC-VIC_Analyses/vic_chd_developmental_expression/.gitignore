# Figures are regenerated by make_figure.py. The repo-root .gitignore also
# ignores figures/.
figures/
*.png
*.pdf
*.svg

# Raw source data is not redistributed here. The SCP1897 count matrix is
# 2.4 GB (see README for how to download it) and the Heart Cell Atlas object
# is 5.8 GB.
SCP1897/
*.h5ad
total_counts2.csv
total_logcounts2.csv

# Per-cell atlas data identifies donors (donor ID + gestational week). It must
# never be committed; only the age-bin summary in data/ is shipped.
fhm_vic_cells_*.tsv*
*_donor.tsv

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Cluster logs
slurm-*.out
logs/
